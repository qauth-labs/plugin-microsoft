{
  // The published build: Node's ESM with declarations, from src/ into dist/.
  // A published plugin ships JavaScript: Node does not strip TypeScript types
  // under node_modules.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
